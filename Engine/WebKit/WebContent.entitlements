<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- JavaScript's just-in-time compiler: a hardened runtime exception notarization accepts. WebKit's engineering
	     build gives its web content process this, fatal-exceptions and get-task-allow (debugging: not in a release). -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
