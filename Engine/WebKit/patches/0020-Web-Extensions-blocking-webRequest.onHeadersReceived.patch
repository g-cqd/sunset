+void WebExtensionContext::resourceLoadDidReceiveResponseHeaders(WebPageProxyIdentifier pageID, const ResourceLoadInfo& loadInfo, const WebCore::ResourceResponse& response, WebExtensionWebRequestDecision& decision)
+{
+    // A blocking webRequest.onHeadersReceived listener decides before the response is handed to the page: { cancel: true }
+    // fails the load; { responseHeaders } replaces the response's headers.
+    constexpr auto eventType = WebExtensionEventListenerType::WebRequestOnHeadersReceivedBlocking;
+    auto blockingProcesses = processes(eventType, WebExtensionContentWorldType::Main);
+    if (blockingProcesses.isEmpty())
+        return;
+
+    auto identifiers = webRequestEventTabAndWindowIdentifiers(pageID, response.url(), loadInfo);
+    if (!identifiers)
+        return;
+
+    auto [tabIdentifier, windowIdentifier] = *identifiers;
+
+    for (auto& process : blockingProcesses) {
+        decision.expect();
+        process->sendWithAsyncReply(Messages::WebExtensionContextProxy::ResourceLoadDidReceiveResponseHeaders(tabIdentifier, windowIdentifier, response, loadInfo), [decision = Ref { decision }](bool cancel, std::optional<WebCore::HTTPHeaderMap>&& responseHeaders) {
+            decision->add(cancel, { }, { }, { }, WTF::move(responseHeaders));
+        }, identifier());
+    }
+}
