+        LOADER_RELEASE_LOG("tryStoreAsCacheEntry: Not storing cache entry because an extension changed the response headers");
+        return;
+    }
+#endif
 
     if (isCrossOriginPrefetch()) {
         if (CheckedPtr session = protect(NetworkProcess::singleton())->networkSession(sessionID())) {
