+
+void WebExtensionController::resourceLoadDidReceiveResponseHeaders(WebPageProxyIdentifier pageID, const ResourceLoadInfo& loadInfo, const WebCore::ResourceResponse& response, CompletionHandler<void(bool cancel, std::optional<WebCore::HTTPHeaderMap>&& responseHeaders)>&& completionHandler)
+{
+    Ref decision = WebExtensionWebRequestDecision::create(WTF::move(completionHandler));
+
+    // Expected until every context has sent its question, so an early answer does not finish it.
+    decision->expect();
+    for (Ref context : m_extensionContexts) {
+        if (context->hasBlockingWebRequestListeners())
+            context->resourceLoadDidReceiveResponseHeaders(pageID, loadInfo, response, decision);
+    }
+    decision->add(false, { }, { }, { });
+
+    holdWebRequestDecision(decision);
+}
+
+void WebExtensionController::holdWebRequestDecision(WebExtensionWebRequestDecision& decision)
+{
+    // The answers of every extension with blocking listeners; a load is not held longer than this, whatever an extension does.
+    static constexpr Seconds maximumWait { 2_s };
+
+    if (decision.isFinished())
         return;
 
-    m_heldWebRequestDecisions.append({ MonotonicTime::now() + maximumWait, decision });
