+#if ENABLE(WK_WEB_EXTENSIONS)
+// An extension's blocking webRequest.onHeadersReceived listener decides before the response is handed on (as in Firefox
+// and Chrome): it may fail the load, or replace the response's headers (a Content-Security-Policy added, say). Held only
+// for pages whose extensions have one. Not asked: synchronous loads, multipart responses, and revalidated cache entries
+// (their headers are the cache's). True when the response is held for the answer.
+bool NetworkResourceLoader::askWebRequestListenersAboutResponse(ResourceResponse& receivedResponse, PrivateRelayed privateRelayed, ResponseCompletionHandler& completionHandler)
+{
+    if (std::exchange(m_webRequestListenersAnsweredResponse, false))
+        return false;
+    if (!m_parameters.pageHasBlockingWebRequestListeners || isSynchronous() || receivedResponse.isMultipart())
+        return false;
+    if (m_cacheEntryForValidation && receivedResponse.httpStatusCode() == httpStatus304NotModified)
+        return false;
+
+    // A message holds references to its arguments, and is encoded after the reply handler has taken the response: it is
+    // given copies that outlive the send.
+    auto pageID = webPageProxyID();
+    auto loadInfo = resourceLoadInfo();
+    auto responseForMessage = receivedResponse;
+    protect(NetworkProcess::singleton())->parentProcessConnection()->sendWithAsyncReply(Messages::NetworkProcessProxy::ResourceLoadDidReceiveResponseHeaders(pageID, loadInfo, responseForMessage), [weakThis = WeakPtr { *this }, response = WTF::move(receivedResponse), privateRelayed, completionHandler = WTF::move(completionHandler)](bool cancel, std::optional<HTTPHeaderMap>&& responseHeaders) mutable {
+        RefPtr protectedThis = weakThis.get();
+        if (!protectedThis)
+            return completionHandler(PolicyAction::Ignore);
+
+        if (cancel) {
+            RunLoop::mainSingleton().dispatch([protectedThis] {
+                if (RefPtr networkLoad = protectedThis->m_networkLoad)
+                    protectedThis->didFailLoading(blockedByContentBlockerError(networkLoad->currentRequest()));
+            });
+            return completionHandler(PolicyAction::Ignore);
+        }
+
+        protectedThis->m_webRequestListenersChangedResponseHeaders = !!responseHeaders;
+        if (responseHeaders)
+            response.setHTTPHeaderFields(WTF::move(*responseHeaders));
+
+        protectedThis->m_webRequestListenersAnsweredResponse = true;
+        protectedThis->didReceiveResponse(WTF::move(response), privateRelayed, WTF::move(completionHandler));
+    }, 0);
+    return true;
+}
+#endif
+
 void NetworkResourceLoader::didReceiveResponse(ResourceResponse&& receivedResponse, PrivateRelayed privateRelayed, ResponseCompletionHandler&& completionHandler)
 {
+#if ENABLE(WK_WEB_EXTENSIONS)
+    if (askWebRequestListenersAboutResponse(receivedResponse, privateRelayed, completionHandler))
+        return;
+#endif
+
 #if HAVE(BROKEN_MULTIPART_RESPONSE_FLOW_CONTROL)
     if (m_isProcessingResponse) {
         m_deferredMessages.append(DeferredResponse { WTF::move(receivedResponse), privateRelayed, WTF::move(completionHandler) });
