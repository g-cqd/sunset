Subject: [PATCH] Web Extensions: test that ws and wss match patterns parse
 (Sunset W7)

WKWebExtensionMatchPatternTests.webSocketSchemes and WKWebExtensionAPIWebRequestTests.webSocketMatchPatternsInFilter;
both fail without the previous patch (the scheme "ws" is invalid).

diff --git a/Tools/TestWebKitAPI/Tests/WebKit/WKWebView/WKWebExtensionAPIWebRequest.swift b/Tools/TestWebKitAPI/Tests/WebKit/WKWebView/WKWebExtensionAPIWebRequest.swift
index 7a1dea195..3b5f95371 100644
--- a/Tools/TestWebKitAPI/Tests/WebKit/WKWebView/WKWebExtensionAPIWebRequest.swift
+++ b/Tools/TestWebKitAPI/Tests/WebKit/WKWebView/WKWebExtensionAPIWebRequest.swift
@@ -92,6 +92,25 @@ struct WKWebExtensionAPIWebRequestTests {
         try await manager.run()
     }
 
+    // WebSocket match patterns are accepted in a filter, as in Firefox and Chrome: uBlock Origin listens on
+    // ["http://*/*", "https://*/*", "ws://*/*", "wss://*/*"], and the whole addListener() call was refused for the ws one.
+    @Test
+    func webSocketMatchPatternsInFilter() async throws {
+        let backgroundScript = """
+            const listener = () => { }
+            try {
+                browser.webRequest.onBeforeRequest.addListener(listener, { urls: ['http://*/*', 'https://*/*', 'ws://*/*', 'wss://*/*'] })
+                browser.test.assertTrue(browser.webRequest.onBeforeRequest.hasListener(listener), 'The listener should be added')
+                browser.test.notifyPass()
+            } catch (error) {
+                browser.test.notifyFail(String(error))
+            }
+            """
+
+        let manager = try loadWebExtension(manifest: webRequestManifest, resources: ["background.js": backgroundScript])
+        try await manager.run()
+    }
+
     @Test
     func manifestV2Persistent() async throws {
         let backgroundScript = """
