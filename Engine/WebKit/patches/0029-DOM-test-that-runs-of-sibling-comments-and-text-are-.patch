+import Testing
+import WebKit
+
+// Appending or removing a child that is not an element (a comment, a text node) beside a run of such children took time
+// in the run's length, from the parser or from script: each looked for the element siblings, though only element
+// changes need them. Parsing n sibling
+// comments was quadratic (40,000 in 1.4 s; Chrome Canary, 21 ms). Measured by how time grows from n to 4n: about 4 when
+// linear, 16 when quadratic.
+@MainActor
+struct HTMLParserSiblingRunsTests {
+    private func growth(of markup: String, count: Int, removing: Bool = false, appending: Bool = false) async throws -> Double {
+        let webView = WKWebView(frame: CGRect(x: 0, y: 0, width: 400, height: 300))
+        let script = """
+            const time = (n) => {
+                const markup = unit.repeat(n)
+                let best = Infinity
+                for (let i = 0; i < 3; i++) {
+                    const host = document.createElement('div')
+                    if (removing)
+                        host.innerHTML = markup
+                    const start = performance.now()
+                    if (removing) {
+                        while (host.lastChild)
+                            host.removeChild(host.lastChild)
+                    } else if (appending) {
+                        for (let i = 0; i < n; i++)
+                            host.appendChild(document.createComment('x'))
+                    } else
+                        host.innerHTML = markup
+                    best = Math.min(best, performance.now() - start)
+                }
+                return best
+            }
+            time(count)
+            return time(4 * count) / Math.max(time(count), 1)
+            """
+        let result = try await webView.callAsyncJavaScript(script, arguments: ["unit": markup, "count": count, "removing": removing, "appending": appending], contentWorld: .page)
+        return try #require(result as? Double)
+    }
+
+    @Test
+    func siblingCommentsParseInLinearTime() async throws {
+        let ratio = try await growth(of: "<!--x-->", count: 20_000)
+        #expect(ratio < 8, "time grew \(ratio) times for 4 times the comments")
+    }
+
+    @Test
+    func alternatingTextAndCommentsParseInLinearTime() async throws {
+        let ratio = try await growth(of: "x<!--y-->", count: 20_000)
+        #expect(ratio < 8, "time grew \(ratio) times for 4 times the text and comments")
+    }
+
+    @Test
+    func siblingCommentsAreAppendedByScriptInLinearTime() async throws {
+        let ratio = try await growth(of: "", count: 10_000, appending: true)
+        #expect(ratio < 8, "time grew \(ratio) times for 4 times the comments appended")
+    }
+
+    @Test
+    func siblingCommentsAreRemovedInLinearTime() async throws {
+        let ratio = try await growth(of: "<!--x-->", count: 10_000, removing: true)
+        #expect(ratio < 8, "time grew \(ratio) times for 4 times the comments removed")
+    }
+}
