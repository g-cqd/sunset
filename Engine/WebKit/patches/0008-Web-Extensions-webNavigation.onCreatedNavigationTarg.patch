+WebExtensionAPIWebNavigationEvent& WebExtensionAPIWebNavigation::onCreatedNavigationTarget()
+{
+    // Documentation: https://developer.mozilla.org/en-US/docs/Mozilla/Add-ons/WebExtensions/API/webNavigation/onCreatedNavigationTarget
+
+    if (!m_onCreatedNavigationTargetEvent)
+        lazyInitialize(m_onCreatedNavigationTargetEvent, WebExtensionAPIWebNavigationEvent::create(*this, WebExtensionEventListenerType::WebNavigationOnCreatedNavigationTarget));
+
+    return *m_onCreatedNavigationTargetEvent;
+}
+
+void WebExtensionContextProxy::dispatchWebNavigationCreatedNavigationTargetEvent(WebExtensionTabIdentifier sourceTabID, WebExtensionFrameIdentifier sourceFrameID, WebExtensionTabIdentifier tabID, const URL& url, WallTime timestamp)
+{
+    // Documentation: https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/webNavigation/onCreatedNavigationTarget
+
+    NSDictionary *details = @{
+        sourceTabIdKey: @(toWebAPI(sourceTabID)),
+        sourceFrameIdKey: @(toWebAPI(sourceFrameID)),
+        tabIdKey: @(toWebAPI(tabID)),
+        urlKey: url.string().createNSString().get(),
+        timeStampKey: @(floor(timestamp.approximate<WallTime>().secondsSinceEpoch().milliseconds()))
+    };
+
+    enumerateNamespaceObjects([&](auto& namespaceObject) {
+        Ref webNavigationObject = namespaceObject.webNavigation();
+        protect(webNavigationObject->onCreatedNavigationTarget())->invokeListenersWithArgument(details, url.createNSURL().get());
+    });
+}
+
 void WebExtensionContextProxy::dispatchWebNavigationEvent(WebExtensionEventListenerType type, WebExtensionTabIdentifier tabID, const WebExtensionFrameParameters& frameParameters, WallTime timestamp)
 {
     ASSERT(frameParameters.url);
