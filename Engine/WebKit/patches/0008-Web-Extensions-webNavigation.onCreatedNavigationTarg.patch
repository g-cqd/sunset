+
+void WebExtensionContext::fireWebNavigationCreatedNavigationTargetEventIfNeeded(WebExtensionTab& tab)
+{
+    // A tab opened by a page (window.open, a link with a target): webNavigation.onCreatedNavigationTarget, with the tab
+    // and frame that opened it, as in Firefox and Chrome.
+    RetainPtr webView = tab.webView();
+    if (!webView)
+        return;
+
+    RefPtr page = [webView _page].get();
+    if (!page)
+        return;
+
+    auto openerFrameIdentifier = page->openerFrameIdentifier();
+    if (!openerFrameIdentifier)
+        return;
+
+    RefPtr openerFrame = WebFrameProxy::webFrame(openerFrameIdentifier);
+    if (!openerFrame)
+        return;
+
+    RefPtr openerPage = openerFrame->page();
+    if (!openerPage)
+        return;
+
+    RefPtr sourceTab = getTab(openerPage->identifier());
+    if (!sourceTab || !hasPermission(WebExtensionPermission::webNavigation(), sourceTab.get()))
+        return;
+
+    auto url = URL { tab.url() };
+    if (!url.isEmpty() && !hasPermission(url, &tab))
+        return;
+
+    auto sourceFrameID = openerFrame->isMainFrame() ? WebExtensionFrameConstants::MainFrameIdentifier : toWebExtensionFrameIdentifier(openerFrameIdentifier);
+    auto timestamp = WallTime::now();
+
+    constexpr auto eventType = WebExtensionEventListenerType::WebNavigationOnCreatedNavigationTarget;
+    wakeUpBackgroundContentIfNecessaryToFireEvents({ eventType }, [=, this, protectedThis = Ref { *this }, sourceTab = WTF::move(sourceTab), tab = Ref { tab }] {
+        sendToProcessesForEvent(eventType, Messages::WebExtensionContextProxy::DispatchWebNavigationCreatedNavigationTargetEvent(sourceTab->identifier(), sourceFrameID, tab->identifier(), url, timestamp));
+    });
 }
 
