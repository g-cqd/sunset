Date: Sat, 21 Nov 2026 16:42:18 +0100
Subject: [PATCH] CSS: test that :nth-child() in querySelectorAll takes linear
 time (Sunset P5)

Siblings alone, and siblings whose own children are matched in between:
time from n to 4n 13.3 and 16.7 before the change that follows (32,000
siblings: 1.2 s). A third counts matches across changes between queries;
the same as the system's WebKit and Chrome Canary.

diff --git a/Tools/TestWebKitAPI/Tests/WebKit/WKWebView/DOMLinearTime.swift b/Tools/TestWebKitAPI/Tests/WebKit/WKWebView/DOMLinearTime.swift
index bbd953b5c..229f2719c 100644
--- a/Tools/TestWebKitAPI/Tests/WebKit/WKWebView/DOMLinearTime.swift
+++ b/Tools/TestWebKitAPI/Tests/WebKit/WKWebView/DOMLinearTime.swift
@@ -116,6 +116,49 @@ struct DOMLinearTimeTests {
         #expect(result == "2-4 1-3 3-5 3-5 3-6 3")
     }
 
+    @Test
+    func nthChildQueryInLinearTime() async throws {
+        // querySelectorAll counted each candidate's previous siblings (the child index cache is filled by style resolution
+        // only): 32,000 siblings took 1.2 s (Chrome Canary: linear). The children made before count; they are cheap.
+        let body = """
+            host.innerHTML = '<i></i>'.repeat(n)
+            return host.querySelectorAll('i:nth-child(3n+1)').length
+            """
+        let ratio = try await growth(body, count: 5_000)
+        #expect(ratio < 8, "time grew \(ratio) times for 4 times the siblings")
+    }
+
+    @Test
+    func nthChildQueryOverSiblingsWithChildrenInLinearTime() async throws {
+        // Each sibling's own children are matched between two siblings: the count of one must survive them.
+        let body = """
+            host.innerHTML = '<p><b></b><b></b></p>'.repeat(n)
+            return host.querySelectorAll(':nth-child(odd)').length
+            """
+        let ratio = try await growth(body, count: 4_000)
+        #expect(ratio < 8, "time grew \(ratio) times for 4 times the siblings")
+    }
+
+    @Test
+    func nthChildQueryFollowsChanges() async throws {
+        let webView = WKWebView(frame: CGRect(x: 0, y: 0, width: 400, height: 300))
+        let script = """
+            const host = document.createElement('div')
+            host.innerHTML = '<p><b></b><b></b><b></b></p>'.repeat(7)
+            const seen = []
+            const count = (selector) => host.querySelectorAll(selector).length
+            seen.push(count(':nth-child(2n+1)'), count('p:nth-child(-n+3)'), count('b:nth-child(2)'), count(':nth-child(3) > :nth-child(3)'))
+            host.prepend(document.createElement('p'))
+            host.children[4].remove()
+            seen.push(count('p:nth-child(odd)'), host.querySelector('p:nth-child(5)') === host.children[4])
+            host.insertBefore(document.createComment('c'), host.children[2])
+            seen.push(count('p:nth-child(2n)'), [...host.children].map((element) => element.matches(':nth-child(3n)') ? 1 : 0).join(''))
+            return seen.join(' ')
+            """
+        let result = try await webView.callAsyncJavaScript(script, contentWorld: .page) as? String
+        #expect(result == "18 3 7 1 4 true 3 0010010")
+    }
+
     @Test
     func normalizeKeepsRangesOnMergedText() async throws {
         let webView = WKWebView(frame: CGRect(x: 0, y: 0, width: 400, height: 300))
