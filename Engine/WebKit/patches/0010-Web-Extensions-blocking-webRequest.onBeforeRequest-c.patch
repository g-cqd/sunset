+
+void WebExtensionContext::blockingWebRequestListenersChanged()
+{
+    // Every web process of the controller is told, so its pages hold their loads for the decision (or no longer do).
+    if (RefPtr controller = extensionController())
+        controller->sendToAllProcesses(Messages::WebExtensionContextProxy::SetHasBlockingWebRequestListeners(hasBlockingWebRequestListeners()), identifier());
+}
+
+void WebExtensionContext::resourceLoadWillSendRequest(WebPageProxyIdentifier pageID, const ResourceLoadInfo& loadInfo, const WebCore::ResourceRequest& request, WebExtensionWebRequestDecision& decision)
+{
+    // A blocking webRequest.onBeforeRequest listener decides before the request is sent: { cancel: true } fails the load.
+    constexpr auto eventType = WebExtensionEventListenerType::WebRequestOnBeforeRequestBlocking;
+    auto blockingProcesses = processes(eventType, WebExtensionContentWorldType::Main);
+    if (blockingProcesses.isEmpty())
+        return;
+
+    auto identifiers = webRequestEventTabAndWindowIdentifiers(pageID, request.url(), loadInfo);
+    if (!identifiers)
+        return;
+
+    auto [tabIdentifier, windowIdentifier] = *identifiers;
+
+    for (auto& process : blockingProcesses) {
+        decision.expect();
+        process->sendWithAsyncReply(Messages::WebExtensionContextProxy::ResourceLoadWillSendRequest(tabIdentifier, windowIdentifier, request, loadInfo), [decision = Ref { decision }](bool cancel) {
+            decision->add(cancel);
+        }, identifier());
+    }
+}
