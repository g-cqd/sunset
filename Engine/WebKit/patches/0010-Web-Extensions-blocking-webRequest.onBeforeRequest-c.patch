+void WebExtensionController::resourceLoadWillSendRequest(WebPageProxyIdentifier pageID, const ResourceLoadInfo& loadInfo, const WebCore::ResourceRequest& request, CompletionHandler<void(bool cancel)>&& completionHandler)
+{
+    // The answers of every extension with blocking listeners; a load is not held longer than this, whatever an extension does.
+    static constexpr Seconds maximumWait { 2_s };
+
+    Ref decision = WebExtensionWebRequestDecision::create(WTF::move(completionHandler));
+
+    // Expected until every context has sent its question, so an early answer does not finish it.
+    decision->expect();
+    for (Ref context : m_extensionContexts) {
+        if (context->hasBlockingWebRequestListeners())
+            context->resourceLoadWillSendRequest(pageID, loadInfo, request, decision);
+    }
+    decision->add(false);
+
+    if (decision->isFinished())
+        return;
+
+    m_heldWebRequestDecisions.append({ MonotonicTime::now() + maximumWait, decision });
+    if (!m_webRequestDecisionTimer) {
+        m_webRequestDecisionTimer = makeUnique<RunLoop::Timer>(RunLoop::mainSingleton(), "WebExtensionController::WebRequestDecisionTimer"_s, [weakThis = WeakPtr { *this }] {
+            if (RefPtr protectedThis = weakThis.get())
+                protectedThis->webRequestDecisionTimerFired();
+        });
+    }
+    if (!m_webRequestDecisionTimer->isActive())
+        m_webRequestDecisionTimer->startOneShot(maximumWait);
+}
+
+void WebExtensionController::webRequestDecisionTimerFired()
+{
+    // Answered decisions are dropped; the ones past their time are answered as they stand.
+    auto now = MonotonicTime::now();
+    while (!m_heldWebRequestDecisions.isEmpty()) {
+        auto& [deadline, decision] = m_heldWebRequestDecisions.first();
+        if (!decision->isFinished() && deadline > now) {
+            m_webRequestDecisionTimer->startOneShot(deadline - now);
+            return;
+        }
+        Ref finished = m_heldWebRequestDecisions.takeFirst().second;
+        finished->finish();
+    }
+}
