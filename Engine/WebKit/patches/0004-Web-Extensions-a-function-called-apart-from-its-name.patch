From: Gigi <42325924+g-cqd@users.noreply.github.com>
Date: Fri, 20 Nov 2026 22:18:23 +0100
Subject: [PATCH] Web Extensions: a function called apart from its namespace
 finds it (Sunset W1)

`const getURL = browser.runtime.getURL; getURL(path)` gave undefined: each generated function finds its object from
`this`, and a detached call has none. Firefox and Chrome give the URL; uBlock Origin's background page does this at its
start and stopped there.

A namespace is the one object of its class in its context (browser and chrome are the same object). When a wrapper is
made, JSWebExtensionWrapper records it as its class's sole wrapper in the context (a weak map; a class with two objects
alive at once, such as events or ports, is marked as having none). A generated function whose `this` is not an object of
its class falls back to that sole wrapper; calls through the object take no new step, and nothing is bound or allocated
per function.

Measured (release, 10 runs, against the base): 200 000 getURL calls 485 ms against 491; 100 fresh extension frames 81 ms
against 79; web content memory unchanged.

diff --git a/Source/WebKit/WebProcess/Extensions/Bindings/JSWebExtensionWrapper.cpp b/Source/WebKit/WebProcess/Extensions/Bindings/JSWebExtensionWrapper.cpp
index e327ce3d5..0bc57a704 100644
--- a/Source/WebKit/WebProcess/Extensions/Bindings/JSWebExtensionWrapper.cpp
+++ b/Source/WebKit/WebProcess/Extensions/Bindings/JSWebExtensionWrapper.cpp
@@ -534,6 +534,49 @@ static inline JSValueRef getCachedWrapper(JSContextRef context, JSWeakObjectMapR
     return nullptr;
 }
 
+NODELETE static HashMap<JSGlobalContextRef, JSWeakObjectMapRef>& soleWrapperCache()
+{
+    static NeverDestroyed<HashMap<JSGlobalContextRef, JSWeakObjectMapRef>> wrappers;
+    return wrappers;
+}
+
+static void soleWrapperMapDestroyed(JSWeakObjectMapRef, void* context)
+{
+    soleWrapperCache().remove(static_cast<JSGlobalContextRef>(context));
+}
+
+static inline JSWeakObjectMapRef soleWrapperMap(JSContextRef context)
+{
+    auto globalContext = JSContextGetGlobalContext(context);
+    return soleWrapperCache().ensure(globalContext, [&] {
+        return JSWeakObjectMapCreate(globalContext, globalContext, soleWrapperMapDestroyed);
+    }).iterator->value;
+}
+
+// The context's global object marks a class with more than one object alive at once: no sole wrapper.
+static void recordSoleWrapper(JSContextRef context, JSClassRef jsClass, JSObjectRef wrapper)
+{
+    SUPPRESS_UNCOUNTED_LOCAL auto map = soleWrapperMap(context);
+    auto ambiguous = JSContextGetGlobalObject(context);
+    auto existing = JSWeakObjectMapGet(context, map, jsClass);
+    if (existing == ambiguous || existing == wrapper)
+        return;
+
+    JSWeakObjectMapSet(context, map, jsClass, existing && JSObjectGetPrivate(existing) ? ambiguous : wrapper);
+}
+
+JSObjectRef JSWebExtensionWrapper::soleWrapper(JSContextRef context, JSClassRef jsClass)
+{
+    if (!context || !jsClass)
+        return nullptr;
+
+    auto existing = JSWeakObjectMapGet(context, soleWrapperMap(context), jsClass);
+    if (!existing || existing == JSContextGetGlobalObject(context) || !JSObjectGetPrivate(existing))
+        return nullptr;
+
+    return existing;
+}
+
 JSValueRef JSWebExtensionWrapper::wrap(JSContextRef context, JSWebExtensionWrappable* object, JSObjectRef holder, JSStringRef propertyName)
 {
     ASSERT(context);
@@ -570,6 +613,7 @@ JSValueRef JSWebExtensionWrapper::wrap(JSContextRef context, JSWebExtensionWrapp
     ASSERT(wrapper);
 
     JSWeakObjectMapSet(context, wrappers, object, wrapper);
+    recordSoleWrapper(context, objectClass.get(), wrapper);
 
     return wrapper;
 }
diff --git a/Source/WebKit/WebProcess/Extensions/Bindings/JSWebExtensionWrapper.h b/Source/WebKit/WebProcess/Extensions/Bindings/JSWebExtensionWrapper.h
index 68425189f..827702fa6 100644
--- a/Source/WebKit/WebProcess/Extensions/Bindings/JSWebExtensionWrapper.h
+++ b/Source/WebKit/WebProcess/Extensions/Bindings/JSWebExtensionWrapper.h
@@ -63,6 +63,11 @@ public:
     // Wrapped for an attribute of `holder`: a new wrapper is kept as long as `holder` (what a script adds to a namespace
     // object is not lost when the wrapper would be collected). A wrapper found in the cache costs nothing more.
     static JSValueRef wrap(JSContextRef, JSWebExtensionWrappable*, JSObjectRef holder, JSStringRef propertyName);
+
+    // The one object of `jsClass` in this context (a namespace), or null when there is none or more than one: a function
+    // called apart from its object (`const getURL = browser.runtime.getURL; getURL(path)`) runs on it, as in Firefox and
+    // Chrome.
+    static JSObjectRef soleWrapper(JSContextRef, JSClassRef);
     static JSWebExtensionWrappable* unwrap(JSContextRef, JSValueRef);
 
     static void initialize(JSContextRef, JSObjectRef);
diff --git a/Source/WebKit/WebProcess/Extensions/Bindings/Scripts/CodeGeneratorExtensions.pm b/Source/WebKit/WebProcess/Extensions/Bindings/Scripts/CodeGeneratorExtensions.pm
index 325c1ba05..0d9f49017 100644
--- a/Source/WebKit/WebProcess/Extensions/Bindings/Scripts/CodeGeneratorExtensions.pm
+++ b/Source/WebKit/WebProcess/Extensions/Bindings/Scripts/CodeGeneratorExtensions.pm
@@ -498,6 +498,11 @@ EOF
 
 {
     RefPtr impl = to${implementationClassName}(context, thisObject);
+    if (!impl) [[unlikely]] {
+        // Called apart from its object (`const getURL = browser.runtime.getURL; getURL(path)`): the one object of its class
+        // in this context, as in Firefox and Chrome. Nothing is bound and nothing is spent on calls through the object.
+        impl = to${implementationClassName}(context, JSWebExtensionWrapper::soleWrapper(context, ${className}::${classRefGetter}()));
+    }
     if (${functionEarlyReturnCondition}) [[unlikely]]
         return ${defaultEarlyReturnValue};
 
