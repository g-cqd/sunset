Subject: [PATCH] DOM: test that a Range's contents are taken out in linear
 time (Sunset P3)

extractContents over n children: time from n to 4n 16.2 before the
change that follows (32,000 children: 2.9 s). A second test follows a
Range's offsets across removals and insertions before and inside it;
the same values as the system's WebKit and Chrome Canary.

diff --git a/Tools/TestWebKitAPI/Tests/WebKit/WKWebView/DOMLinearTime.swift b/Tools/TestWebKitAPI/Tests/WebKit/WKWebView/DOMLinearTime.swift
index c8823fb51..bbd953b5c 100644
--- a/Tools/TestWebKitAPI/Tests/WebKit/WKWebView/DOMLinearTime.swift
+++ b/Tools/TestWebKitAPI/Tests/WebKit/WKWebView/DOMLinearTime.swift
@@ -78,6 +78,44 @@ struct DOMLinearTimeTests {
         #expect(ratio < 8, "time grew \(ratio) times for 4 times the text nodes")
     }
 
+    @Test
+    func rangeExtractsChildrenInLinearTime() async throws {
+        // A Range's boundary after a child had its offset recomputed by walking the siblings at every change of the
+        // container's children, so taking n children out of a Range one at a time was quadratic.
+        let body = """
+            host.innerHTML = '<b>x</b>'.repeat(n)
+            const range = document.createRange()
+            range.selectNodeContents(host)
+            return range.extractContents().childNodes.length
+            """
+        let ratio = try await growth(body, count: 5_000)
+        #expect(ratio < 8, "time grew \(ratio) times for 4 times the children")
+    }
+
+    @Test
+    func rangeOffsetsFollowChildChanges() async throws {
+        let webView = WKWebView(frame: CGRect(x: 0, y: 0, width: 400, height: 300))
+        let script = """
+            const host = document.createElement('div')
+            host.innerHTML = '<i></i><i></i><i></i><i></i><i></i>'
+            const range = document.createRange()
+            range.setStart(host, 2)
+            range.setEnd(host, 4)
+            const seen = [range.startOffset + '-' + range.endOffset]
+            host.firstChild.remove()
+            seen.push(range.startOffset + '-' + range.endOffset)
+            host.prepend(document.createElement('b'), document.createElement('b'))
+            seen.push(range.startOffset + '-' + range.endOffset)
+            host.lastChild.remove()
+            seen.push(range.startOffset + '-' + range.endOffset)
+            host.insertBefore(document.createElement('u'), host.children[3])
+            seen.push(range.startOffset + '-' + range.endOffset + ' ' + range.cloneContents().childNodes.length)
+            return seen.join(' ')
+            """
+        let result = try await webView.callAsyncJavaScript(script, contentWorld: .page) as? String
+        #expect(result == "2-4 1-3 3-5 3-5 3-6 3")
+    }
+
     @Test
     func normalizeKeepsRangesOnMergedText() async throws {
         let webView = WKWebView(frame: CGRect(x: 0, y: 0, width: 400, height: 300))
