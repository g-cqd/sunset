From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gigi <42325924+g-cqd@users.noreply.github.com>
Date: Sat, 21 Nov 2026 00:38:00 +0100
Subject: [PATCH] Web Extensions: a blocking webRequest redirect to the
 extension's own file or to data: answers the request (Sunset W6d)

uBlock Origin answers some requests with a neutered script of its own (a surrogate): { redirectUrl } to one of its web
accessible files, or to a data: URL. Firefox and Chrome make such redirects internal; WebKit refused both (a subresource
redirected to data:, or to a scheme the network process cannot load), so the page lost the script instead of getting the
stand-in.

The UI process, gathering the answers, reads the extension's file (when web accessible to the page) or decodes the data:
URL, and hands its MIME type and bytes to the network process, which answers the load with them (status 200, the
original URL, Access-Control-Allow-Origin: * as the extension chose to answer it), after the response checks a cached
answer gets. A main resource is never substituted (blocked instead). The bytes go from the UI process to the network
process only: listed as NotSentFromWebContent.

diff --git a/Source/WebKit/NetworkProcess/NetworkResourceLoader.cpp b/Source/WebKit/NetworkProcess/NetworkResourceLoader.cpp
index 4f84c01d8..b9e02ce13 100644
--- a/Source/WebKit/NetworkProcess/NetworkResourceLoader.cpp
+++ b/Source/WebKit/NetworkProcess/NetworkResourceLoader.cpp
@@ -318,6 +318,43 @@ void NetworkResourceLoader::startRequest(const ResourceRequest& newRequest)
     startCacheOrNetworkLoad(useCache ? ResourceRequest { originalRequest() } : ResourceRequest { newRequest }, useCache);
 }
 
+#if ENABLE(WK_WEB_EXTENSIONS)
+void NetworkResourceLoader::answerWithWebRequestSubstitute(const ResourceRequest& request, String&& mimeType, Vector<uint8_t>&& data)
+{
+    // A main resource is not replaced (a page is redirected, not substituted): it is blocked instead, as before.
+    if (isMainResource() || isSynchronous()) {
+        didFailLoading(blockedByContentBlockerError(request));
+        return;
+    }
+
+    ResourceResponse response { URL { request.url() }, WTF::move(mimeType), static_cast<long long>(data.size()), { } };
+    response.setHTTPStatusCode(200);
+    response.setHTTPStatusText("OK"_s);
+    response.setHTTPHeaderField(HTTPHeaderName::ContentType, response.mimeType());
+    // The extension chose to answer this request: as Firefox and Chrome, the page may read it from any origin.
+    response.setHTTPHeaderField(HTTPHeaderName::AccessControlAllowOrigin, "*"_s);
+    response.setSource(ResourceResponse::Source::Network);
+
+    if (m_networkLoadChecker) {
+        auto error = m_networkLoadChecker->validateResponse(originalRequest(), response);
+        if (!error.isNull()) {
+            didFailLoading(error);
+            return;
+        }
+    }
+
+    if (!m_firstResponseURL.isValid())
+        m_firstResponseURL = response.url();
+    sendDidReceiveResponseWithPotentialProcessSwap(response, PrivateRelayed::No, false);
+    sendBuffer(SharedBuffer::create(WTF::move(data)));
+
+    NetworkLoadMetrics metrics;
+    metrics.markComplete();
+    send(Messages::WebResourceLoader::DidFinishResourceLoad(WTF::move(metrics)));
+    cleanup(LoadResult::Success);
+}
+#endif
+
 void NetworkResourceLoader::startCacheOrNetworkLoad(ResourceRequest&& request, bool useCache)
 {
 #if ENABLE(WK_WEB_EXTENSIONS)
@@ -325,7 +362,7 @@ void NetworkResourceLoader::startCacheOrNetworkLoad(ResourceRequest&& request, b
     // the network (as in Firefox and Chrome). Held only for pages whose extensions have one; never a synchronous load.
     if (m_parameters.pageHasBlockingWebRequestListeners && !m_didAskWebRequestListeners && !isSynchronous()) {
         m_didAskWebRequestListeners = true;
-        protect(NetworkProcess::singleton())->parentProcessConnection()->sendWithAsyncReply(Messages::NetworkProcessProxy::ResourceLoadWillSendRequest(webPageProxyID(), resourceLoadInfo(), request), [weakThis = WeakPtr { *this }, request = WTF::move(request), useCache](bool cancel, URL&& redirectURL) mutable {
+        protect(NetworkProcess::singleton())->parentProcessConnection()->sendWithAsyncReply(Messages::NetworkProcessProxy::ResourceLoadWillSendRequest(webPageProxyID(), resourceLoadInfo(), request), [weakThis = WeakPtr { *this }, request = WTF::move(request), useCache](bool cancel, URL&& redirectURL, String&& substituteMIMEType, Vector<uint8_t>&& substituteData) mutable {
             RefPtr protectedThis = weakThis.get();
             if (!protectedThis)
                 return;
@@ -335,6 +372,12 @@ void NetworkResourceLoader::startCacheOrNetworkLoad(ResourceRequest&& request, b
                 return;
             }
 
+            if (!substituteMIMEType.isNull()) {
+                // The extension's own file or a data: URL (a surrogate): the load is answered with it.
+                protectedThis->answerWithWebRequestSubstitute(request, WTF::move(substituteMIMEType), WTF::move(substituteData));
+                return;
+            }
+
             if (redirectURL.isValid() && redirectURL != request.url()) {
                 // A redirect the web process checks as any other (CORS, CSP, mixed content), as WebKit's own synthetic
                 // redirects are: the load goes on with the new request once the web process agrees.
