     void expect() { ++m_expected; }
 
-    void add(bool cancel, URL&& redirectURL)
+    // A substitute (MIME type and body) comes with a redirect to the extension's own file or to a data: URL: the load is
+    // answered with it, as Firefox and Chrome do for such redirects.
+    void add(bool cancel, URL&& redirectURL, String&& substituteMIMEType, Vector<uint8_t>&& substituteData)
     {
         m_cancel = m_cancel || cancel;
-        if (!m_redirectURL.isValid() && redirectURL.isValid())
+        if (!m_redirectURL.isValid() && redirectURL.isValid()) {
             m_redirectURL = WTF::move(redirectURL);
+            m_substituteMIMEType = WTF::move(substituteMIMEType);
+            m_substituteData = WTF::move(substituteData);
+        }
         if (m_expected && !--m_expected)
             finish();
     }
 
     void finish()
     {
-        if (m_completionHandler)
-            m_completionHandler(m_cancel, m_cancel ? URL { } : URL { m_redirectURL });
+        if (!m_completionHandler)
+            return;
+        if (m_cancel)
+            m_completionHandler(true, { }, { }, { });
+        else
+            m_completionHandler(false, URL { m_redirectURL }, String { m_substituteMIMEType }, Vector<uint8_t> { m_substituteData });
     }
 
     bool isFinished() const { return !m_completionHandler; }
 
 private:
