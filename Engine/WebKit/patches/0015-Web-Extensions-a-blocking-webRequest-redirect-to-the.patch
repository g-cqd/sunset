+void WebExtensionContext::webRequestSubstitute(const URL& redirectURL, const URL& pageURL, String& mimeType, Vector<uint8_t>& data)
+{
+    // A redirect to a data: URL, or to one of this extension's files the page may load (web accessible): the body the
+    // load is answered with. Firefox and Chrome make such redirects internal; WebKit's loaders would refuse them (a
+    // subresource redirected to data:, or to a scheme the network process cannot load).
+    if (redirectURL.protocolIsData()) {
+        if (auto decoded = WebCore::DataURLDecoder::decode(redirectURL)) {
+            mimeType = decoded->mimeType;
+            data = WTF::move(decoded->data);
+        }
+        return;
+    }
+
+    if (!isURLForThisExtension(redirectURL))
+        return;
+
+    Ref extension = this->extension();
+    if (!extension->isWebAccessibleResource(redirectURL, pageURL))
+        return;
+
+    auto path = redirectURL.path().toString();
+    auto resource = extension->resourceDataForPath(path);
+    if (!resource)
+        return;
+
+    mimeType = extension->resourceMIMETypeForPath(path);
+    data = (*resource)->span();
+}
+
 void WebExtensionContext::resourceLoadWillSendRequest(WebPageProxyIdentifier pageID, const ResourceLoadInfo& loadInfo, const WebCore::ResourceRequest& request, WebExtensionWebRequestDecision& decision)
 {
     // A blocking webRequest.onBeforeRequest listener decides before the request is sent: { cancel: true } fails the load.
@@ -1969,8 +1999,12 @@ void WebExtensionContext::resourceLoadWillSendRequest(WebPageProxyIdentifier pag
 
     for (auto& process : blockingProcesses) {
         decision.expect();
-        process->sendWithAsyncReply(Messages::WebExtensionContextProxy::ResourceLoadWillSendRequest(tabIdentifier, windowIdentifier, request, loadInfo), [decision = Ref { decision }](bool cancel, URL&& redirectURL) {
-            decision->add(cancel, WTF::move(redirectURL));
+        process->sendWithAsyncReply(Messages::WebExtensionContextProxy::ResourceLoadWillSendRequest(tabIdentifier, windowIdentifier, request, loadInfo), [decision = Ref { decision }, weakThis = WeakPtr { *this }, pageURL = request.firstPartyForCookies()](bool cancel, URL&& redirectURL) mutable {
+            String substituteMIMEType;
+            Vector<uint8_t> substituteData;
+            if (RefPtr protectedThis = weakThis.get(); protectedThis && !cancel && redirectURL.isValid())
+                protectedThis->webRequestSubstitute(redirectURL, pageURL, substituteMIMEType, substituteData);
+            decision->add(cancel, WTF::move(redirectURL), WTF::move(substituteMIMEType), WTF::move(substituteData));
         }, identifier());
     }
 }
