+    explicit WebExtensionWebRequestDecision(CompletionHandler<void(bool cancel, URL&& redirectURL, String&& substituteMIMEType, Vector<uint8_t>&& substituteData)>&& completionHandler)
         : m_completionHandler(WTF::move(completionHandler))
