     void fireTabsRemovedEventIfNeeded(WebExtensionTabIdentifier, WebExtensionWindowIdentifier, WindowIsClosing);
 
+    // WebRequest APIs
+    bool isWebRequestMessageAllowed(IPC::Decoder&);
