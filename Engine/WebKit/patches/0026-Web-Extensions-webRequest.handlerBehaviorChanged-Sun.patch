+++ b/Source/WebKit/WebProcess/Extensions/API/Cocoa/WebExtensionAPIWebRequestCocoa.mm
@@ -72,6 +72,15 @@ SUPPRESS_NODELETE NSDictionary *WebExtensionAPIWebRequest::resourceType()
     return types;
 }
 
+void WebExtensionAPIWebRequest::handlerBehaviorChanged(Ref<WebExtensionCallbackHandler>&& callback)
+{
+    // Documentation: https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/webRequest/handlerBehaviorChanged
+    // The in-memory caches are dropped, so listeners that changed apply to resources loaded before.
+    WebProcess::singleton().sendWithAsyncReply(Messages::WebExtensionContext::WebRequestHandlerBehaviorChanged(), [callback = WTF::move(callback)] {
+        callback->call();
+    }, extensionContext().identifier());
+}
+
 WebExtensionAPIWebRequestEvent& WebExtensionAPIWebRequest::onBeforeRequest()
 {
     // Documentation: https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/webRequest/onBeforeRequest
