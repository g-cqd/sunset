Date: Sat, 21 Nov 2026 13:24:39 +0100
Subject: [PATCH] Web Extensions: webRequest.handlerBehaviorChanged (Sunset
 W4b)

As in Firefox: the memory caches of the controller's data stores are
dropped, so listeners that changed apply to what pages load again (a
Content-Security-Policy added after a page was in the memory cache, for
one). At most 20 calls in 10 minutes; past that a call does nothing.
Needs the webRequest permission.

diff --git a/Source/WebKit/UIProcess/Extensions/Cocoa/WebExtensionContextCocoa.mm b/Source/WebKit/UIProcess/Extensions/Cocoa/WebExtensionContextCocoa.mm
index 0bdd61e83..6b9177a35 100644
--- a/Source/WebKit/UIProcess/Extensions/Cocoa/WebExtensionContextCocoa.mm
+++ b/Source/WebKit/UIProcess/Extensions/Cocoa/WebExtensionContextCocoa.mm
@@ -1942,6 +1942,36 @@ void WebExtensionContext::resourceLoadDidSendRequest(WebPageProxyIdentifier page
     });
 }
 
+bool WebExtensionContext::isWebRequestMessageAllowed(IPC::Decoder& message)
+{
+    return isLoadedAndPrivilegedMessage(message) && hasPermission(WebExtensionPermission::webRequest());
+}
+
+void WebExtensionContext::webRequestHandlerBehaviorChanged(CompletionHandler<void()>&& completionHandler)
+{
+    // As in Firefox: the in-memory caches of the controller's pages are dropped (resources, back/forward pages), so
+    // listeners that changed apply to what those pages load again; at most 20 times in 10 minutes, calls past that do
+    // nothing (each drop costs every page its cache).
+    static constexpr size_t maximumCalls = 20;
+    static constexpr Seconds period = 10_min;
+
+    auto now = MonotonicTime::now();
+    while (!m_handlerBehaviorChangedTimes.isEmpty() && now - m_handlerBehaviorChangedTimes.first() > period)
+        m_handlerBehaviorChangedTimes.removeFirst();
+
+    RefPtr controller = extensionController();
+    if (!controller || m_handlerBehaviorChangedTimes.size() >= maximumCalls) {
+        completionHandler();
+        return;
+    }
+
+    m_handlerBehaviorChangedTimes.append(now);
+
+    Ref callbackAggregator = CallbackAggregator::create(WTF::move(completionHandler));
+    for (Ref dataStore : controller->allWebsiteDataStores())
+        dataStore->removeData(WebsiteDataType::MemoryCache, -WallTime::infinity(), [callbackAggregator] { });
+}
+
 bool WebExtensionContext::hasBlockingWebRequestListeners() const
 {
     return m_eventListenerFrames.contains({ WebExtensionEventListenerType::WebRequestOnBeforeRequestBlocking, WebExtensionContentWorldType::Main });
