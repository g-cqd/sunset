+    // A page opening a window gives onCreatedNavigationTarget with the tab and frame that opened it, as in Firefox and
+    // Chrome (uBlock Origin blocks pop-ups with it).
+    @Test
+    func createdNavigationTargetEvent() async throws {
+        var server = try HTTPServer(protocol: .http) {
+            Route("/", headerFields: ["Content-Type": "text/html"]) {
+                ""
+            }
+            Route("/target", headerFields: ["Content-Type": "text/html"]) {
+                ""
+            }
+        }
+
+        let backgroundScript = """
+            let sourceTabId
+
+            browser.webNavigation.onCompleted.addListener((details) => {
+                if (sourceTabId !== undefined)
+                    return
+                sourceTabId = details.tabId
+                browser.test.sendMessage('Open Target')
+            })
+
+            browser.webNavigation.onCreatedNavigationTarget.addListener((details) => {
+                browser.test.assertEq(details?.sourceTabId, sourceTabId, 'details.sourceTabId should be the opener')
+                browser.test.assertEq(details?.sourceFrameId, 0, 'details.sourceFrameId should be the main frame')
+                browser.test.assertEq(typeof details?.tabId, 'number', 'details.tabId should be')
+                browser.test.assertTrue(details?.tabId !== sourceTabId, 'details.tabId should be a new tab')
+                browser.test.assertEq(typeof details?.url, 'string', 'details.url should be')
+                browser.test.assertEq(typeof details?.timeStamp, 'number', 'details.timeStamp should be')
+
+                browser.test.notifyPass()
+            })
+
+            browser.test.sendMessage('Load Tab')
+            """
+
+        try await server.run { configuration in
+            let manager = try loadWebExtension(manifest: webNavigationManifest, resources: ["background.js": backgroundScript])
+            let context = try requireNonNil(manager.context)
+
+            context.setPermissionStatus(.grantedExplicitly, for: WKWebExtension.Permission.webNavigation)
+            context.setPermissionStatus(.grantedExplicitly, for: configuration.localhostAddress)
+
+            try await manager.waitForTestMessage("Load Tab")
+
+            let webView = try requireNonNil(manager.defaultTab?.webView)
+            webView.load(URLRequest(url: configuration.localhostAddress))
+
+            try await manager.waitForTestMessage("Open Target")
+            _ = try await webView.evaluateJavaScript("window.open('/target', '_blank'); true")
+
+            try await manager.run()
+        }
+    }
+
     @Test
     func committedEvent() async throws {
         var server = try HTTPServer(protocol: .http) {
