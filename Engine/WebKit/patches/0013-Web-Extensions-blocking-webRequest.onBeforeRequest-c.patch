From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gigi <42325924+g-cqd@users.noreply.github.com>
Date: Fri, 20 Nov 2026 22:48:33 +0100
Subject: [PATCH] Web Extensions: blocking webRequest.onBeforeRequest can
 redirect a request (Sunset W6b)

A blocking listener's { redirectUrl } now redirects the request, as in Firefox and Chrome (Manifest V2); uBlock Origin
replaces scripts with neutered ones this way. A cancel from any listener wins; otherwise the first redirect given.

The network process turns it into a synthetic redirect (ResourceResponse::syntheticRedirectResponse), as WebKit's own
checker does, so the web process checks it as any other redirect (CORS, CSP, mixed content) before the load goes on.
The replies along the way (extension's process, UI process, network process) carry the URL beside the cancel.

diff --git a/Source/WebKit/NetworkProcess/NetworkResourceLoader.cpp b/Source/WebKit/NetworkProcess/NetworkResourceLoader.cpp
index 30f6e6a10..4f84c01d8 100644
--- a/Source/WebKit/NetworkProcess/NetworkResourceLoader.cpp
+++ b/Source/WebKit/NetworkProcess/NetworkResourceLoader.cpp
@@ -325,7 +325,7 @@ void NetworkResourceLoader::startCacheOrNetworkLoad(ResourceRequest&& request, b
     // the network (as in Firefox and Chrome). Held only for pages whose extensions have one; never a synchronous load.
     if (m_parameters.pageHasBlockingWebRequestListeners && !m_didAskWebRequestListeners && !isSynchronous()) {
         m_didAskWebRequestListeners = true;
-        protect(NetworkProcess::singleton())->parentProcessConnection()->sendWithAsyncReply(Messages::NetworkProcessProxy::ResourceLoadWillSendRequest(webPageProxyID(), resourceLoadInfo(), request), [weakThis = WeakPtr { *this }, request = WTF::move(request), useCache](bool cancel) mutable {
+        protect(NetworkProcess::singleton())->parentProcessConnection()->sendWithAsyncReply(Messages::NetworkProcessProxy::ResourceLoadWillSendRequest(webPageProxyID(), resourceLoadInfo(), request), [weakThis = WeakPtr { *this }, request = WTF::move(request), useCache](bool cancel, URL&& redirectURL) mutable {
             RefPtr protectedThis = weakThis.get();
             if (!protectedThis)
                 return;
@@ -335,6 +335,17 @@ void NetworkResourceLoader::startCacheOrNetworkLoad(ResourceRequest&& request, b
                 return;
             }
 
+            if (redirectURL.isValid() && redirectURL != request.url()) {
+                // A redirect the web process checks as any other (CORS, CSP, mixed content), as WebKit's own synthetic
+                // redirects are: the load goes on with the new request once the web process agrees.
+                auto redirectResponse = ResourceResponse::syntheticRedirectResponse(request.url(), redirectURL);
+                ResourceRequest redirectRequest { request };
+                redirectRequest.setURL(WTF::move(redirectURL));
+                protectedThis->m_isWaitingContinueWillSendRequestForCachedRedirect = true;
+                protectedThis->willSendRedirectedRequest(WTF::move(request), WTF::move(redirectRequest), WTF::move(redirectResponse), [](auto) { });
+                return;
+            }
+
             protectedThis->startCacheOrNetworkLoad(WTF::move(request), useCache);
         }, 0);
         return;
diff --git a/Source/WebKit/UIProcess/Extensions/Cocoa/WebExtensionContextCocoa.mm b/Source/WebKit/UIProcess/Extensions/Cocoa/WebExtensionContextCocoa.mm
index ca36c1a61..206a7f418 100644
--- a/Source/WebKit/UIProcess/Extensions/Cocoa/WebExtensionContextCocoa.mm
+++ b/Source/WebKit/UIProcess/Extensions/Cocoa/WebExtensionContextCocoa.mm
@@ -1969,8 +1969,8 @@ void WebExtensionContext::resourceLoadWillSendRequest(WebPageProxyIdentifier pag
 
     for (auto& process : blockingProcesses) {
         decision.expect();
-        process->sendWithAsyncReply(Messages::WebExtensionContextProxy::ResourceLoadWillSendRequest(tabIdentifier, windowIdentifier, request, loadInfo), [decision = Ref { decision }](bool cancel) {
-            decision->add(cancel);
+        process->sendWithAsyncReply(Messages::WebExtensionContextProxy::ResourceLoadWillSendRequest(tabIdentifier, windowIdentifier, request, loadInfo), [decision = Ref { decision }](bool cancel, URL&& redirectURL) {
+            decision->add(cancel, WTF::move(redirectURL));
         }, identifier());
     }
 }
diff --git a/Source/WebKit/UIProcess/Extensions/Cocoa/WebExtensionControllerCocoa.mm b/Source/WebKit/UIProcess/Extensions/Cocoa/WebExtensionControllerCocoa.mm
