 }
 
-void WebExtensionController::resourceLoadWillSendRequest(WebPageProxyIdentifier pageID, const ResourceLoadInfo& loadInfo, const WebCore::ResourceRequest& request, CompletionHandler<void(bool cancel)>&& completionHandler)
+void WebExtensionController::resourceLoadWillSendRequest(WebPageProxyIdentifier pageID, const ResourceLoadInfo& loadInfo, const WebCore::ResourceRequest& request, CompletionHandler<void(bool cancel, URL&& redirectURL)>&& completionHandler)
 {
     // The answers of every extension with blocking listeners; a load is not held longer than this, whatever an extension does.
     static constexpr Seconds maximumWait { 2_s };
@@ -373,7 +373,7 @@ void WebExtensionController::resourceLoadWillSendRequest(WebPageProxyIdentifier
         if (context->hasBlockingWebRequestListeners())
             context->resourceLoadWillSendRequest(pageID, loadInfo, request, decision);
     }
-    decision->add(false);
+    decision->add(false, { });
 
     if (decision->isFinished())
         return;
diff --git a/Source/WebKit/UIProcess/Extensions/WebExtensionContext.h b/Source/WebKit/UIProcess/Extensions/WebExtensionContext.h
index dc9831867..fd82c5b1b 100644
--- a/Source/WebKit/UIProcess/Extensions/WebExtensionContext.h
+++ b/Source/WebKit/UIProcess/Extensions/WebExtensionContext.h
@@ -182,11 +182,12 @@ struct WebExtensionMessageTargetParameters;
 struct ContentRuleListMatchedRule;
 #endif
 
-// The answers of blocking webRequest listeners to one request: the load is cancelled when any of them says so. Answered
-// once: when the last expected answer is in, or at finish() (the time limit), whichever is first.
+// The answers of blocking webRequest listeners to one request: the load is cancelled when any of them says so, else
+// redirected to the first redirect given. Answered once: when the last expected answer is in, or at finish() (the time
+// limit), whichever is first.
 class WebExtensionWebRequestDecision : public RefCounted<WebExtensionWebRequestDecision> {
 public:
-    static Ref<WebExtensionWebRequestDecision> create(CompletionHandler<void(bool cancel)>&& completionHandler)
+    static Ref<WebExtensionWebRequestDecision> create(CompletionHandler<void(bool cancel, URL&& redirectURL)>&& completionHandler)
     {
         return adoptRef(*new WebExtensionWebRequestDecision(WTF::move(completionHandler)));
     }
@@ -195,9 +196,11 @@ public:
 
     void expect() { ++m_expected; }
 
-    void add(bool cancel)
+    void add(bool cancel, URL&& redirectURL)
     {
         m_cancel = m_cancel || cancel;
+        if (!m_redirectURL.isValid() && redirectURL.isValid())
+            m_redirectURL = WTF::move(redirectURL);
         if (m_expected && !--m_expected)
             finish();
     }
@@ -205,18 +208,19 @@ public:
     void finish()
     {
         if (m_completionHandler)
-            m_completionHandler(m_cancel);
+            m_completionHandler(m_cancel, m_cancel ? URL { } : URL { m_redirectURL });
     }
 
     bool isFinished() const { return !m_completionHandler; }
 
 private:
-    explicit WebExtensionWebRequestDecision(CompletionHandler<void(bool cancel)>&& completionHandler)
+    explicit WebExtensionWebRequestDecision(CompletionHandler<void(bool cancel, URL&& redirectURL)>&& completionHandler)
         : m_completionHandler(WTF::move(completionHandler))
     {
     }
 
-    CompletionHandler<void(bool cancel)> m_completionHandler;
+    CompletionHandler<void(bool cancel, URL&& redirectURL)> m_completionHandler;
+    URL m_redirectURL;
     unsigned m_expected { 0 };
     bool m_cancel { false };
 };
