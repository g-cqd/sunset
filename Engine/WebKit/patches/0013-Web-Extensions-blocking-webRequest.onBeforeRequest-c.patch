index 80451ec1b..e675ffaad 100644
--- a/Source/WebKit/WebProcess/Extensions/API/Cocoa/WebExtensionAPIWebRequestCocoa.mm
+++ b/Source/WebKit/WebProcess/Extensions/API/Cocoa/WebExtensionAPIWebRequestCocoa.mm
@@ -307,15 +307,17 @@ static NSMutableDictionary *headersReceivedDetails(const ResourceLoadInfo& resou
     return details;
 }
 
-void WebExtensionContextProxy::resourceLoadWillSendRequest(WebExtensionTabIdentifier tabID, WebExtensionWindowIdentifier windowID, const WebCore::ResourceRequest&, const ResourceLoadInfo& resourceLoad, CompletionHandler<void(bool cancel)>&& completionHandler)
+void WebExtensionContextProxy::resourceLoadWillSendRequest(WebExtensionTabIdentifier tabID, WebExtensionWindowIdentifier windowID, const WebCore::ResourceRequest&, const ResourceLoadInfo& resourceLoad, CompletionHandler<void(bool cancel, URL&& redirectURL)>&& completionHandler)
 {
     // Documentation: https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/webRequest/onBeforeRequest
-    // A blocking listener's answer: { cancel: true } fails the load.
+    // A blocking listener's answer: { cancel: true } fails the load; { redirectUrl } redirects it (the first one given).
 
     static NeverDestroyed<RefPtr<OpaqueJSString>> cancelName = OpaqueJSString::tryCreate("cancel"_s);
+    static NeverDestroyed<RefPtr<OpaqueJSString>> redirectURLName = OpaqueJSString::tryCreate("redirectUrl"_s);
 
     RetainPtr<NSDictionary> details;
     bool cancel = false;
+    URL redirectURL;
 
     enumerateNamespaceObjects([&](auto& namespaceObject) {
         protect(protect(namespaceObject.webRequest())->onBeforeRequest())->enumerateListeners(tabID, windowID, resourceLoad, [&](auto& listener, auto& extraInfo) {
@@ -330,13 +332,23 @@ void WebExtensionContextProxy::resourceLoadWillSendRequest(WebExtensionTabIdenti
             if (!result || !JSValueIsObject(context, result))
                 return;
 
-            auto cancelValue = JSObjectGetProperty(context, JSValueToObject(context, result, nullptr), cancelName.get().get(), nullptr);
+            auto resultObject = JSValueToObject(context, result, nullptr);
+            auto cancelValue = JSObjectGetProperty(context, resultObject, cancelName.get().get(), nullptr);
             if (cancelValue && JSValueToBoolean(context, cancelValue))
                 cancel = true;
+
+            if (redirectURL.isValid())
+                return;
+            auto redirectValue = JSObjectGetProperty(context, resultObject, redirectURLName.get().get(), nullptr);
+            if (!redirectValue || !JSValueIsString(context, redirectValue))
+                return;
+            auto redirectString = adopt(JSValueToStringCopy(context, redirectValue, nullptr));
+            if (URL candidate { redirectString->string() }; candidate.isValid())
+                redirectURL = WTF::move(candidate);
         });
     });
 
-    completionHandler(cancel);
+    completionHandler(cancel, WTF::move(redirectURL));
 }
 
