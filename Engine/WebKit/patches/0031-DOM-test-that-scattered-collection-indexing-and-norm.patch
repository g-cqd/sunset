+import Testing
+import WebKit
+
+// DOM operations that took time in the square of the size where Chrome Canary takes it linearly (diary 2026-11-21-07):
+// indexing a collection at scattered positions walked from the last position each time (20,000 children: 363 ms; Chrome
+// Canary, 4 ms), and normalize() appended each text node's data to the first one by one (20,000 text nodes: 375 ms;
+// Chrome Canary, 10 ms). Measured by how time grows from n to 4n: about 4 when linear, 16 when quadratic.
+@MainActor
+struct DOMLinearTimeTests {
+    private func growth(_ body: String, count: Int) async throws -> Double {
+        let webView = WKWebView(frame: CGRect(x: 0, y: 0, width: 400, height: 300))
+        let script = """
+            const time = (n) => {
+                let best = Infinity
+                for (let i = 0; i < 3; i++) {
+                    const host = document.createElement('div')
+                    const run = new Function('host', 'n', body)
+                    const start = performance.now()
+                    run(host, n)
+                    best = Math.min(best, performance.now() - start)
+                }
+                return best
+            }
+            time(count)
+            return time(4 * count) / Math.max(time(count), 1)
+            """
+        let result = try await webView.callAsyncJavaScript(script, arguments: ["body": body, "count": count], contentWorld: .page)
+        return try #require(result as? Double)
+    }
+
+    @Test
+    func collectionIndexedAtScatteredPositionsInLinearTime() async throws {
+        // The children made before the clock starts would count; made by the parser, they cost little next to the walk.
+        let body = """
+            host.innerHTML = '<b></b>'.repeat(n)
+            const children = host.children
+            let sum = 0
+            for (let i = 0; i < n; i++)
+                sum += children[(i * 7919) % n].nodeType
+            return sum
+            """
+        let ratio = try await growth(body, count: 5_000)
+        #expect(ratio < 8, "time grew \(ratio) times for 4 times the children")
+    }
+
+    @Test
+    func normalizeMergesTextNodesInLinearTime() async throws {
+        let body = """
+            for (let i = 0; i < n; i++)
+                host.appendChild(document.createTextNode('x'))
+            host.normalize()
+            return host.firstChild.length
+            """
+        let ratio = try await growth(body, count: 10_000)
+        #expect(ratio < 8, "time grew \(ratio) times for 4 times the text nodes")
+    }
+
+    @Test
+    func normalizeKeepsRangesOnMergedText() async throws {
+        let webView = WKWebView(frame: CGRect(x: 0, y: 0, width: 400, height: 300))
+        let script = """
+            const host = document.createElement('div')
+            for (const text of ['ab', '', 'cd', 'ef'])
+                host.appendChild(document.createTextNode(text))
+            const range = document.createRange()
+            range.setStart(host.childNodes[2], 1)
+            range.setEnd(host.childNodes[3], 2)
+            host.normalize()
+            return [host.childNodes.length, host.firstChild.data, range.startContainer === host.firstChild, range.startOffset, range.endOffset, range.toString()].join(' ')
+            """
+        let result = try await webView.callAsyncJavaScript(script, contentWorld: .page) as? String
+        #expect(result == "1 abcdef true 3 6 def")
+    }
+}
