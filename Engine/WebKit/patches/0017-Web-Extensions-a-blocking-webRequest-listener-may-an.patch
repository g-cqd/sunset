From: Gigi <42325924+g-cqd@users.noreply.github.com>
Date: Sat, 21 Nov 2026 01:08:20 +0100
Subject: [PATCH] Web Extensions: a blocking webRequest listener may answer
 with a Promise (Sunset W6e)

Firefox waits for a blocking onBeforeRequest listener's Promise; WebKit took it for no answer. uBlock Origin answers so
after looking up a host's name (its CNAME uncloaking), and those requests went through unfiltered.

The extension's process gathers its listeners' answers (WebRequestBlockingAnswers): a plain answer is read at once, a
Promise when it settles (rejected: no answer), the reply sent when all are in. Only when a Promise is pending is a limit
set (two seconds, the UI process's), so one that never settles does not hold the reply; plain answers schedule nothing.

Measured (release, 300 requests, 10 runs, the same machine load): blocking 346 ms with this patch, 342 ms without.

diff --git a/Source/WebKit/WebProcess/Extensions/API/Cocoa/WebExtensionAPIWebRequestCocoa.mm b/Source/WebKit/WebProcess/Extensions/API/Cocoa/WebExtensionAPIWebRequestCocoa.mm
index e675ffaad..d17febcbd 100644
--- a/Source/WebKit/WebProcess/Extensions/API/Cocoa/WebExtensionAPIWebRequestCocoa.mm
+++ b/Source/WebKit/WebProcess/Extensions/API/Cocoa/WebExtensionAPIWebRequestCocoa.mm
@@ -307,17 +307,78 @@ static NSMutableDictionary *headersReceivedDetails(const ResourceLoadInfo& resou
     return details;
 }
 
+// The answers of this process's blocking listeners to one request: replied once, when every answer is in (a Promise's
+// when it settles), or after two seconds with what is in (the UI process waits no longer either).
+class WebRequestBlockingAnswers : public RefCounted<WebRequestBlockingAnswers> {
+public:
+    static Ref<WebRequestBlockingAnswers> create(CompletionHandler<void(bool cancel, URL&& redirectURL)>&& completionHandler)
+    {
+        return adoptRef(*new WebRequestBlockingAnswers(WTF::move(completionHandler)));
+    }
+
+    void expect() { ++m_expected; }
+
+    void add(JSContextRef context, JSValueRef result)
+    {
+        read(context, result);
+        if (m_expected && !--m_expected)
+            finish();
+    }
+
+    void finish()
+    {
+        if (m_completionHandler)
+            m_completionHandler(m_cancel, URL { m_redirectURL });
+    }
+
+    bool isFinished() const { return !m_completionHandler; }
+
+private:
+    explicit WebRequestBlockingAnswers(CompletionHandler<void(bool cancel, URL&& redirectURL)>&& completionHandler)
+        : m_completionHandler(WTF::move(completionHandler))
+    {
+    }
+
+    void read(JSContextRef context, JSValueRef result)
+    {
+        static NeverDestroyed<RefPtr<OpaqueJSString>> cancelName = OpaqueJSString::tryCreate("cancel"_s);
+        static NeverDestroyed<RefPtr<OpaqueJSString>> redirectURLName = OpaqueJSString::tryCreate("redirectUrl"_s);
+
+        if (!context || !result || !JSValueIsObject(context, result))
+            return;
+
+        auto resultObject = JSValueToObject(context, result, nullptr);
+        auto cancelValue = JSObjectGetProperty(context, resultObject, cancelName.get().get(), nullptr);
+        if (cancelValue && JSValueToBoolean(context, cancelValue))
+            m_cancel = true;
+
+        if (m_redirectURL.isValid())
+            return;
+        auto redirectValue = JSObjectGetProperty(context, resultObject, redirectURLName.get().get(), nullptr);
+        if (!redirectValue || !JSValueIsString(context, redirectValue))
+            return;
+        auto redirectString = adopt(JSValueToStringCopy(context, redirectValue, nullptr));
+        if (URL candidate { redirectString->string() }; candidate.isValid())
+            m_redirectURL = WTF::move(candidate);
+    }
+
+    CompletionHandler<void(bool cancel, URL&& redirectURL)> m_completionHandler;
+    URL m_redirectURL;
+    unsigned m_expected { 0 };
+    bool m_cancel { false };
+};
+
 void WebExtensionContextProxy::resourceLoadWillSendRequest(WebExtensionTabIdentifier tabID, WebExtensionWindowIdentifier windowID, const WebCore::ResourceRequest&, const ResourceLoadInfo& resourceLoad, CompletionHandler<void(bool cancel, URL&& redirectURL)>&& completionHandler)
 {
     // Documentation: https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/webRequest/onBeforeRequest
-    // A blocking listener's answer: { cancel: true } fails the load; { redirectUrl } redirects it (the first one given).
-
-    static NeverDestroyed<RefPtr<OpaqueJSString>> cancelName = OpaqueJSString::tryCreate("cancel"_s);
-    static NeverDestroyed<RefPtr<OpaqueJSString>> redirectURLName = OpaqueJSString::tryCreate("redirectUrl"_s);
+    // A blocking listener's answer, given or promised: { cancel: true } fails the load; { redirectUrl } redirects it (the
+    // first one given).
 
+    Ref answers = WebRequestBlockingAnswers::create(WTF::move(completionHandler));
     RetainPtr<NSDictionary> details;
-    bool cancel = false;
-    URL redirectURL;
+
+    // Expected until every listener has been called, so an early answer does not reply.
+    answers->expect();
 
     enumerateNamespaceObjects([&](auto& namespaceObject) {
         protect(protect(namespaceObject.webRequest())->onBeforeRequest())->enumerateListeners(tabID, windowID, resourceLoad, [&](auto& listener, auto& extraInfo) {
@@ -329,26 +390,34 @@ void WebExtensionContextProxy::resourceLoadWillSendRequest(WebExtensionTabIdenti
 
             auto context = listener.globalContext();
             auto result = listener.call(toJSValueRef(context, details.get()));
-            if (!result || !JSValueIsObject(context, result))
+            if (!result || !isThenable(context, result)) {
+                answers->expect();
+                answers->add(context, result);
                 return;
+            }
 
-            auto resultObject = JSValueToObject(context, result, nullptr);
-            auto cancelValue = JSObjectGetProperty(context, resultObject, cancelName.get().get(), nullptr);
-            if (cancelValue && JSValueToBoolean(context, cancelValue))
-                cancel = true;
-
-            if (redirectURL.isValid())
-                return;
-            auto redirectValue = JSObjectGetProperty(context, resultObject, redirectURLName.get().get(), nullptr);
-            if (!redirectValue || !JSValueIsString(context, redirectValue))
-                return;
-            auto redirectString = adopt(JSValueToStringCopy(context, redirectValue, nullptr));
-            if (URL candidate { redirectString->string() }; candidate.isValid())
-                redirectURL = WTF::move(candidate);
+            // A Promise: waited for. Using BlockPtr does not work here (JSValue needs a block with a signature).
+            answers->expect();
+            auto answersWrapper = Ref { answers };
+            JSValue *promise = toJSValue(context, result);
+            auto resolveBlock = ^(JSValue *value) {
+                Ref { answersWrapper }->add(value.context.JSGlobalContextRef, value.JSValueRef);
+            };
+            auto rejectBlock = ^(JSValue *) {
+                Ref { answersWrapper }->add(nullptr, nullptr);
+            };
+            [promise invokeMethod:@"then" withArguments:@[ resolveBlock, rejectBlock ]];
         });
     });
 
-    completionHandler(cancel, WTF::move(redirectURL));
+    answers->add(nullptr, nullptr);
+
+    // Only a Promise can leave it waiting: then a limit, so one that never settles does not hold the request's reply.
+    if (!answers->isFinished()) {
+        RunLoop::mainSingleton().dispatchAfter(2_s, [answers] {
+            answers->finish();
+        });
+    }
 }
 
 void WebExtensionContextProxy::resourceLoadDidSendRequest(WebExtensionTabIdentifier tabID, WebExtensionWindowIdentifier windowID, const WebCore::ResourceRequest& request, const ResourceLoadInfo& resourceLoad, const std::optional<IPC::FormDataReference>& formDataOptional)
