-// An extension's blocking webRequest.onHeadersReceived listener decides before the response is handed on (as in Firefox
-// and Chrome): it may fail the load, or replace the response's headers (a Content-Security-Policy added, say). Held only
-// for pages whose extensions have one. Not asked: synchronous loads and multipart responses. A 304 is not asked here:
-// the cache entry it revalidates is, in askWebRequestListenersAboutCacheEntry(). True when the response is held.
+// An extension's blocking webRequest.onHeadersReceived listener decides before a document's response is handed on (as in
+// Firefox and Chrome): it may fail the load, or replace the response's headers (a Content-Security-Policy added, say).
+// Held only for pages whose extensions have one, and only for documents (a frame's main resource), where headers decide
+// what the page may do: a held response waits a round trip to the extension (about 0.4 ms each with uBlock Origin, diary
+// 2026-11-21-06), which every subresource would pay. Subresources go on; their listeners see them, without a say. Not
+// asked: synchronous loads and multipart responses. A 304 is not asked here: the cache entry it revalidates is, in
+// askWebRequestListenersAboutCacheEntry(). True when the response is held.
 bool NetworkResourceLoader::askWebRequestListenersAboutResponse(ResourceResponse& receivedResponse, PrivateRelayed privateRelayed, ResponseCompletionHandler& completionHandler)
 {
     if (std::exchange(m_webRequestListenersAnsweredResponse, false))
         return false;
-    if (!m_parameters.pageHasBlockingWebRequestListeners || isSynchronous() || receivedResponse.isMultipart())
+    if (!m_parameters.pageHasBlockingWebRequestHeadersListeners || !isMainResource() || isSynchronous() || receivedResponse.isMultipart())
         return false;
     if (m_cacheEntryForValidation && receivedResponse.httpStatusCode() == httpStatus304NotModified)
         return false;
@@ -1515,6 +1522,7 @@ bool NetworkResourceLoader::askWebRequestListenersAboutResponse(ResourceResponse
             response.setHTTPHeaderFields(WTF::move(*responseHeaders));
 
         protectedThis->m_webRequestListenersAnsweredResponse = true;
+        protectedThis->m_blockingListenersWereAskedAboutResponse = true;
         protectedThis->didReceiveResponse(WTF::move(response), privateRelayed, WTF::move(completionHandler));
     }, 0);
     return true;
@@ -1526,7 +1534,7 @@ bool NetworkResourceLoader::askWebRequestListenersAboutCacheEntry(std::unique_pt
 {
     if (std::exchange(m_webRequestListenersAnsweredResponse, false))
         return false;
-    if (!m_parameters.pageHasBlockingWebRequestListeners || isSynchronous() || entry->redirectRequest())
+    if (!m_parameters.pageHasBlockingWebRequestHeadersListeners || !isMainResource() || isSynchronous() || entry->redirectRequest())
         return false;
 
     // A message holds references to its arguments, and is encoded after the reply handler has taken the entry.
@@ -1550,6 +1558,7 @@ bool NetworkResourceLoader::askWebRequestListenersAboutCacheEntry(std::unique_pt
         }
 
         protectedThis->m_webRequestListenersAnsweredResponse = true;
+        protectedThis->m_blockingListenersWereAskedAboutResponse = true;
         protectedThis->didRetrieveCacheEntry(WTF::move(entry));
     }, 0);
     return true;
