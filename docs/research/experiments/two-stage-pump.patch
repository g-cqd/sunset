+    /// Written after the pump, not before it (the stage that fills buffers while another parses is the point of it): it holds the property in place.
+    @Test func `while the parse stage is busy the gather stage reads ahead, up to the ring, and no further`()
+        async throws
+    {
+        let process = try spawn("head -c 8000000 /dev/zero | tr '\\0' x")
+        let pump = process.pump
+        let release = Atomic<Bool>(false)
+        let running = Task(executorPreference: process.readThread) {
+            var total = 0
+            pump.run { bytes in
+                if total == 0 { while !release.load(ordering: .acquiring) { _ = usleep(1000) } }
+                total += bytes.count
+            }
+            return total
+        }
+        try await Task.sleep(for: .milliseconds(600))
+        let ahead = pump.pendingBytes
+        #expect(ahead >= 2 * OutputPump.slotSize, "read ahead only \(ahead) bytes")
+        #expect(ahead <= OutputPump.slotCount * OutputPump.slotSize, "read ahead \(ahead) bytes, more than the ring")
+        release.store(true, ordering: .releasing)
+        #expect(await running.value == 8_000_000)
+    }
+
+    @Test func `a short output is delivered at once, not held back to fill a buffer`() async throws {
