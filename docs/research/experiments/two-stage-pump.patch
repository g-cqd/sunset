diff --git a/Sources/SunsetHost/PumpWake.swift b/Sources/SunsetHost/PumpWake.swift
new file mode 100644
index 0000000..32fe94e
--- /dev/null
+++ b/Sources/SunsetHost/PumpWake.swift
@@ -0,0 +1,38 @@
+internal import Darwin
+
+/// A pipe used as a wake-up signal: `poke` makes the read end readable, `drain` empties it. Poll the read end together with other descriptors to wait for
+/// "something happened or the terminal has output" without a timeout. Both ends are non-blocking and close-on-exec; -1 when the pipe could not be made.
+struct PumpWake: Sendable {
+    let readEnd: Int32
+    let writeEnd: Int32
+
+    init() {
+        var ends: [Int32] = [-1, -1]
+        if pipe(&ends) == 0 {
+            for end in ends {
+                _ = fcntl(end, F_SETFL, fcntl(end, F_GETFL) | O_NONBLOCK)
+                _ = fcntl(end, F_SETFD, FD_CLOEXEC)
+            }
+        } else {
+            ends = [-1, -1]
+        }
+        (readEnd, writeEnd) = (ends[0], ends[1])
+    }
+
+    func poke() {
+        guard writeEnd >= 0 else { return }
+        var byte: UInt8 = 1
+        _ = unsafe write(writeEnd, &byte, 1)
+    }
+
+    func drain() {
+        guard readEnd >= 0 else { return }
+        var scratch = [UInt8](repeating: 0, count: 16)
+        while unsafe read(readEnd, &scratch, scratch.count) > 0 {}
+    }
+
+    func close() {
+        if readEnd >= 0 { Darwin.close(readEnd) }
+        if writeEnd >= 0 { Darwin.close(writeEnd) }
+    }
+}
