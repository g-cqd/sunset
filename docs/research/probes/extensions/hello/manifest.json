{
  "manifest_version": 3,
  "name": "Hello Sunset",
  "version": "1.0",
  "description": "A probe: a content script, a worker, storage.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_end" }]
}
