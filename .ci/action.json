{
  "project": {
    "linux": false
  },
  "swift": {
    "versions": [
      "6.4.2"
    ]
  },
  "checks": {
    "macos-release": [
      "merge-queue",
      "tag",
      "dispatch",
      "nightly"
    ]
  },
  "quality": {
    "paths": [
      "Sources"
    ],
    "analyzers": [
      "deadwood",
      "dolly",
      "arcleak"
    ],
    "discipline": {}
  },
  "commands": [
    {
      "id": "mutation",
      "title": "Verification \u00b7 Mutation (litmus)",
      "os": "macOS",
      "cadence": [
        "pull-request"
      ],
      "mutation": {
        "paths": [
          "Sources/SunsetCore/**",
          "Sources/SunsetPane/**",
          "Sources/SunsetConfig/**",
          "Sources/SunsetDocuments/**"
        ],
        "budget": 3600,
        "workspace": "copy"
      }
    }
  ],
  "dependabot": {
    "exclude": [
      "Package.swift",
      "Benchmarks/Package.swift",
      "**/Fixtures/**",
      ".build/**"
    ]
  }
}
