<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Under the hardened runtime: what a page the person allows may use, each still asked by macOS and by Sunset.
  None needs a provisioning profile, so an ad hoc build carries them too. The team's own (keychain access groups) are added by
  Signing.local.xcconfig with App/Sunset.team.entitlements, which needs the profile.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
